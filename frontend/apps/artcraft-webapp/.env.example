# Google OAuth Configuration
# Get the Client ID from the Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Uncloud / self-host Docker build (set in deploy/docker/Dockerfile.web build args).
# VITE_ARTCRAFT_SELF_HOSTED=true
# Optional explicit API origin; leave empty for same-origin via nginx.
# VITE_API_ORIGIN=
