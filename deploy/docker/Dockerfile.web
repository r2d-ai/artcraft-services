# ArtCraft webapp — Vite/Nx production build + nginx runtime.
# Build context: repository root (../.. from deploy/uncloud).

FROM node:22-bookworm-slim AS builder

WORKDIR /workspace/frontend

COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci

COPY frontend/ ./

ARG VITE_ARTCRAFT_SELF_HOSTED=true
ARG VITE_API_ORIGIN=
ARG VITE_GOOGLE_CLIENT_ID=

ENV VITE_ARTCRAFT_SELF_HOSTED=${VITE_ARTCRAFT_SELF_HOSTED}
ENV VITE_API_ORIGIN=${VITE_API_ORIGIN}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}

RUN npx nx build artcraft-webapp

FROM nginx:1.27-alpine AS runtime

RUN apk add --no-cache bash

COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf
COPY deploy/docker/entrypoint.sh /docker-entrypoint.d/40-artcraft-config.sh
RUN chmod +x /docker-entrypoint.d/40-artcraft-config.sh

COPY --from=builder /workspace/frontend/apps/artcraft-webapp/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
