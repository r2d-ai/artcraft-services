# Copy to deploy/uncloud/.env and fill in values before uc deploy.
# Credentials are runtime-only; never pass secrets as Docker build args.

# ----- Public ingress -----
# HTTPS hostname for artcraft-web (Uncloud x-ports).
ARTCRAFT_PUBLIC_HOST=studio.example.com
ARTCRAFT_IMAGE_TAG=local
GIT_SHA=unknown

# Optional: force API origin in the browser (default: same-origin via nginx).
# VITE_API_ORIGIN=
# ARTCRAFT_API_PUBLIC_ORIGIN=

VITE_GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# ----- MySQL -----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=storyteller
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=storyteller
MYSQL_URL=mysql://storyteller:change-me@artcraft-mysql:3306/storyteller

# Pre-deploy migration connection (often same host as MYSQL_URL).
MYSQL_MIGRATION_HOST=artcraft-mysql
MYSQL_MIGRATION_PORT=3306
MYSQL_MIGRATION_USER=storyteller
MYSQL_MIGRATION_PASSWORD=change-me
MYSQL_MIGRATION_DATABASE=storyteller

# ----- Redis -----
REDIS_PASSWORD=change-me-redis
REDIS_0_URL=redis://:change-me-redis@artcraft-redis:6379/0

# ----- Elasticsearch -----
ELASTICSEARCH_PASSWORD=change-me-elastic
ELASTICSEARCH_URL=http://elastic:change-me-elastic@artcraft-elasticsearch:9200

# ----- S3-compatible object storage -----
S3_ACCESS_KEY=artcraft
S3_SECRET_KEY=change-me-please
S3_COMPATIBLE_ENDPOINT_URL=http://artcraft-seaweedfs:8333
REGION_NAME=us-east-1
W2L_PRIVATE_DOWNLOAD_BUCKET_NAME=artcraft-private
W2L_PUBLIC_DOWNLOAD_BUCKET_NAME=artcraft-public
GC_ENABLED_PUBLIC_BUCKET_NAME=artcraft-public-gc
AUDIO_UPLOADS_BUCKET_ROOT=/user_uploaded_audio
# ARTCRAFT_SKIP_S3_BOOTSTRAP=true

# ----- storyteller-web -----
SERVER_ENVIRONMENT=production
COOKIE_SECURE=true
COOKIE_DOMAIN=studio.example.com
COOKIE_SECRET=change-me-cookie
SORT_KEY_SECRET=change-me-sort
WEBSITE_HOMEPAGE_REDIRECT=https://studio.example.com
NUM_WORKERS=4

# ----- Third-party providers (placeholders let API start; set real keys per feature) -----
FAL_API_KEY=unset
FAL_WEBHOOK_URL=https://studio.example.com/v1/webhooks/fal
GMICLOUD_API_KEY=unset
GROK_API_KEY=unset
OPENAI_API_KEY=unset
WORLDLABS_API_KEY=unset
BEEBLE_API_KEY=unset
BEEBLE_WEBHOOK_URL=https://studio.example.com/v1/webhooks/beeble
SEEDANCE2PRO_COOKIES=unset
SEEDANCE2PRO_WHITELIST_COOKIES=unset
SEEDANCE2PRO_BYTEPLUS_ULTRA_COOKIES=unset
RESEND_API_KEY=unset

STRIPE_SECRET_KEY=unset
STRIPE_SECRET_WEBHOOK_SIGNING_KEY=unset
STRIPE_FAKEYOU_ACCOUNT_ID=unset
STRIPE_PORTAL_DEFAULT_CONFIG_ID=unset
STRIPE_CHECKOUT_SUCCESS_URL_PATH=/checkout_success
STRIPE_CHECKOUT_CANCEL_URL_PATH=/checkout_cancel
STRIPE_PORTAL_RETURN_URL_PATH=/portal_success
STRIPE_ARTCRAFT_ACCOUNT_ID=unset
STRIPE_ARTCRAFT_SECRET_KEY=unset
STRIPE_ARTCRAFT_SECRET_WEBHOOK_KEY=unset
STRIPE_ARTCRAFT_CHECKOUT_SUCCESS_URL=https://studio.example.com/checkout_success
STRIPE_ARTCRAFT_CHECKOUT_CANCEL_URL=https://studio.example.com/checkout_cancel
STRIPE_ARTCRAFT_PORTAL_RETURN_URL=https://studio.example.com/portal_closed

# ----- Keycloak / OIDC (phase 3 — configure when IdP values are known) -----
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://studio.example.com/v1/auth/oidc/callback

# ----- Internal AI provider adapter (phase 4) -----
# INTERNAL_PROVIDER_URL=
# SELF_HOSTED=true
