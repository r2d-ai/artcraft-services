# ----- Public ingress -----
PUBLIC_HTTP_PORT=8080

# ----- Self-hosted mode -----
SELF_HOSTED=true
SELF_HOSTED_SKIP_CREDIT_BILLING=true
OIDC_ONLY=false

# ----- OIDC / Keycloak (required when OIDC_ENABLED=true) -----
OIDC_ENABLED=false
OIDC_ISSUER=https://keycloak.example.com/realms/artcraft
OIDC_CLIENT_ID=artcraft-studio
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://studio.example.com/v1/auth/oidc/callback
OIDC_POST_LOGIN_REDIRECT=https://studio.example.com/

# ----- Internal OpenAI-compatible provider (optional) -----
INTERNAL_PROVIDER_URL=
INTERNAL_PROVIDER_API_KEY=
INTERNAL_PROVIDER_IMAGE_MODEL=flux-dev
INTERNAL_PROVIDER_ROUTED_IMAGE_MODELS=flux_1_dev

# ----- Data stores (use managed services in production) -----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
MYSQL_URL=mysql://storyteller:change-me@artcraft-mysql:3306/storyteller
REDIS_PASSWORD=change-me
REDIS_0_URL=redis://:change-me@artcraft-redis:6379/0
ELASTICSEARCH_URL=https://elastic:change-me@artcraft-elasticsearch:9200
ELASTICSEARCH_PASSWORD=change-me

# ----- storyteller-web (see build/selfhost/.env.example for full list) -----
COOKIE_SECURE=true
COOKIE_DOMAIN=studio.example.com
COOKIE_SECRET=change-me
SORT_KEY_SECRET=change-me
WEBSITE_HOMEPAGE_REDIRECT=https://studio.example.com/
